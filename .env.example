# ── Saathi Backend — environment configuration ─────────────────────────────
# Copy to `.env` and fill in. The server refuses to boot without MONGO_URI.

# Runtime
ENV=dev                      # dev | prod
PORT=8080
LOG_LEVEL=debug              # debug | info | warn | error

# MongoDB (REQUIRED — no in-code default, env only)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=saathi

# Auth & crypto secrets (change ALL of these outside dev)
JWT_SECRET=dev-only-jwt-secret-change-me
QR_SIGNING_SECRET=dev-only-qr-secret-change-me
OTP_HASH_SECRET=dev-only-otp-secret-change-me

# Consumer-app-only gate for /consumer/traceability (+ PDF label). FAIL-CLOSED:
# if unset, ALL traceability requests are denied. Must equal the consumer app's
# EXPO_PUBLIC_CONSUMER_APP_KEY.
CONSUMER_APP_KEY=dev-only-consumer-app-key

# Token lifetimes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5

# Dev conveniences (MUST be false in prod)
OTP_DEV_MODE=true            # true → OTP returned in the API response instead of SMS

# Abuse protection
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Redis (OPTIONAL) — when set, rate limiting uses a shared Redis token bucket
# for global fairness across API replicas. Leave EMPTY for single-instance /
# dev (in-process limiting). Duplicate-prevention does NOT use Redis — that is
# handled by MongoDB atomic updates. Also the seam for cross-replica SSE fan-out.
# REDIS_URL=redis://localhost:6379/0

# Seeding
SEED_ADMIN_PHONE=9999999999

# ── Deploy-test database (MongoDB Atlas) ────────────────────────────────────
# For a shared test deployment, point MONGO_URI at your Atlas cluster and use
# a separate DB name. Provision the clean slate with `./bin/saathi-seed -minimal`
# (org tree + super admin + one onboarding executive only).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>
# MONGO_DB=saathi_dev

# Fixture profile photo stamped by the seed on demo/admin parties (optional).
SEED_PROFILE_PHOTO_URL=
# ── Notification providers (optional; in-app inbox works without any) ──────
# SMS_PROVIDER= / SMS_API_KEY= (msg91|twilio|sns) · PUSH_PROVIDER=expo (free)

# ── Private media storage (Backblaze B2, native API) ────────────────────────
# Master/application key pair for the PRIVATE media bucket (photos: van pickup,
# plant intake, KYC/profile). Keys live ONLY here — never in any client app.
# The uploads module lazily creates B2_BUCKET (allPrivate) if it doesn't exist.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=pyaas-saathi-media
# Consumer product images ride the SAME bucket under the catalog/ prefix, served
# publicly (unauthenticated, read-only) via GET /consumer/catalog/img/<file>
# which 302s to a fresh short-lived, prefix-scoped B2 download URL. Uses the keys
# above — no extra config.

# ── Phase-2 backend-authoritative catalog (consumer module) ─────────────────
# The 48 baseline consumer products are ALWAYS seeded into consumer_catalog on
# boot (idempotent, kind="product", store_id="_global"). This flag only controls
# whether GET /consumer/catalog SERVES them to the app:
#   false (default): response is byte-identical to the overlay-only behaviour.
#   true:            the seeded products are emitted as additions[] (with images
#                    + compliance) — pair with the app's
#                    EXPO_PUBLIC_CATALOG_BACKEND_AUTHORITATIVE=true.
CONSUMER_CATALOG_SEED_SERVE=false

# ── Razorpay payment RECOVERY (razorpay_recovery.go) ────────────────────────
# RAZORPAY_WEBHOOK_SECRET: the WEBHOOK signing secret from the Razorpay
#   dashboard (Settings → Webhooks → add the endpoint, then copy its secret).
#   This is NOT the API key secret above — a different value for a different
#   purpose. It authenticates Razorpay's server-to-server calls to
#     POST /api/v1/consumer/payments/razorpay/webhook
#   Subscribe the endpoint to: payment.captured and order.paid
#
#   WHY IT MATTERS: without it, the ONLY way a payment becomes wallet money is
#   the app calling /wallet/verify after checkout. On UPI the customer leaves
#   for GPay/PhonePe and that return leg fails often — the money is captured and
#   the wallet is never credited. The webhook and the reconciliation sweep are
#   two independent nets that do not depend on the customer's phone at all.
#
#   Empty → the webhook endpoint rejects every request (fails closed) and the
#   behaviour is exactly as before, so this can ship before it is configured.
#   The reconciliation sweep needs no key of its own: it runs whenever
#   RAZORPAY_KEY_SECRET is set, asking the gateway about our own still-pending
#   orders every 5 minutes (10-minute grace, 7-day horizon).
RAZORPAY_WEBHOOK_SECRET=

# ── AutoPay: Smart Recharge that FUNDS the wallet (mandate.go, autopay.go) ──
# MANDATE_AUTODEBIT=true arms the server's OWN AutoPay charges: the Smart
#   Recharge sweep (every 15 min) and the Founding Family seat top-up. Each
#   charge TOPS UP the wallet from the member's ACTIVE, bank-confirmed UPI
#   AutoPay mandate when the wallet, less the next locked and upcoming
#   mornings (and a Rs 99 bill due within 48 h), falls below the member's
#   threshold; the wallet is credited only when the payment is CAPTURED
#   (webhook or reconcile sweep), exactly once. It NEVER debits the wallet
#   (the retired meaning of this switch). Automatic charges start only from
#   07:00 to 22:00 IST (quiet hours: a need at night waits for 07:00). Off
#   (default): no automatic charge; the registration credit and a member's
#   own "top up now" still work.
#   Needs RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (recurring payments enabled on
#   the Razorpay account) and the webhook subscribed to payment.captured,
#   order.paid, payment.failed, token.confirmed, token.rejected, token.paused
#   and token.cancelled. Without the keys nothing is ever charged.
MANDATE_AUTODEBIT=false

# RAZORPAY_API_BASE_URL: dry-run / E2E stub for the gateway (never set in
#   production). Replaces Razorpay's scheme://host (default
#   https://api.razorpay.com) for EVERY call the backend makes: top-up and
#   AutoPay orders, the recurring charge, payment and token lookups and the
#   reconciliation sweep. The /v1 path, method, basic auth and body stay what
#   production sends. Unset = the real gateway.
# RAZORPAY_API_BASE_URL=http://127.0.0.1:9009

# ADMIN_API_KEY: server-to-server key for the admin delivery CRM
# (/api/v1/consumer/admin/*), sent as X-Admin-Key by the website's SERVER route
# only. >= 32 chars; empty = key auth off (SUPER_ADMIN token still works).
ADMIN_API_KEY=

# ── CRM: Welcome Litre campaign (Rev3) ──────────────────────────────────────
# MASTER SWITCH. Everything CRM — enrolment, the ₹0 promo packs, the trigger
# worker, the consumer inbox, the operator console — is inert unless this is
# exactly "true". Off (default): the binary behaves byte-identically to the
# pre-CRM build. Per-trigger kill switches live in the flags collection as
# crm.trigger.<ID> (POST /consumer/crm/flags, STORE_MANAGER/SUPER_ADMIN).
CRM_ENABLED=false
# Phase B message channels (Phase A = in-app inbox, no keys needed).
# When these are provided the dispatcher will ALSO send over SMS/WhatsApp per
# each trigger's delivery routing (primary/parallel/fallback in
# crm_triggers.json); until then every send lands in consumer_inbox only and
# the binary behaves byte-identically to Phase A.
#
# ── SMS (MSG91 Flow API — DLT-registered campaign templates) ──
# CRM_MSG91_AUTHKEY: the account auth key from MSG91 dashboard → Settings →
#   API Keys. Empty → the SMS channel does not exist.
CRM_MSG91_AUTHKEY=
# CRM_MSG91_SENDER: OPTIONAL. The 6-char DLT header (sender id) approved on
#   the DLT portal and configured in MSG91 (e.g. PYAASD). Leave it empty and
#   the MSG91 template's own sender applies.
CRM_MSG91_SENDER=
# CRM_DLT_TEMPLATE_IDS: JSON object mapping a CRM TRIGGER id or TEMPLATE id →
#   the MSG91 template id of the matching SMS template. The VALUE is the id
#   MSG91 shows for the template in its own panel (SMS → Templates / Flow: the
#   template id / flow id) — NOT the 19-digit DLT template id from the DLT
#   portal (1207…). MSG91 already holds the DLT id against its own template;
#   given the DLT id here it refuses the send and the message never leaves (the
#   dispatch row records the refusal under channel_errors, with an ERROR log).
#   Values are plain strings.
#   KEYS: a trigger id ("B-06") covers that trigger's OWN template (its plain
#   template, or the "then" branch of a conditional one). A template id
#   ("T-B05-PROMO") covers that exact body and is looked up first. A body
#   with neither (for example T-B05-PROMO, B-06's Pyaas-credit wording, when
#   only "B-06" is mapped, or T-W01-LATER) never goes out by SMS: it reaches
#   the inbox (and push) only, never under another body's registration.
#   A trigger or body absent from this map NEVER attempts SMS — sending
#   unregistered content is a TRAI violation, so it degrades to the other
#   channels with a logged reason. Fill per trigger as registrations land;
#   only new env is needed, never a rebuild.
#   Register each template's variables named after the CRM tokens LOWERCASED
#   (##date##, ##link##, ##support_number## …; B-06 "money added" uses ##x##
#   for the rupees and ##reason##; a DLT variable holds at most 30 characters,
#   see docs/CRM-MESSAGES.md section 3) — the channel
#   sends variables only; the SMS text itself is the registered template. SMS
#   always carries the ROMAN body's variables (hi_roman/en) — never Devanagari.
#   A value may also be {"en":"<id>","hi":"<id>"} when the English and the
#   hi_roman bodies are two registrations; a language missing from it is
#   unmapped (skipped with a logged reason, never sent under the other id).
#   Malformed JSON — including a value of any other type — disables ALL SMS
#   mappings (logged once at startup): misconfiguration can never cause an
#   unregistered send.
#   Example:
#   {"W-01":"<msg91 template id>","B-06":"<msg91 template id>","T-B05-PROMO":"<msg91 template id>"}
CRM_DLT_TEMPLATE_IDS=
#
# ── WhatsApp (Meta Cloud API — pre-approved business templates) ──
# CRM_WA_TOKEN: permanent system-user access token from Meta Business Manager
#   (Business Settings → System Users → Generate Token, with the
#   whatsapp_business_messaging permission).
# CRM_WA_PHONE_ID: the phone-number ID (NOT the phone number) from WhatsApp
#   Manager → API Setup. The channel is inert unless BOTH are set.
CRM_WA_TOKEN=
CRM_WA_PHONE_ID=
# CRM_WA_TEMPLATE_NAMES: JSON object mapping CRM TRIGGER id (or TEMPLATE id,
#   looked up first; the same key rule as CRM_DLT_TEMPLATE_IDS) → the APPROVED
#   template name in WhatsApp Manager → Message Templates. Business-initiated
#   WhatsApp requires a pre-approved template, so an unmapped trigger or body
#   never attempts the channel. Register each template's {{1}},{{2}},… body slots in
#   the same order the CRM tokens appear in the routed body variant
#   (hi_devanagari preferred, else hi_roman, else en — the language code sent
#   follows: hi/en).
#   Example: {"W-01":"pyaas_w01_welcome","W-06":"pyaas_w06_recharge"}
CRM_WA_TEMPLATE_NAMES=
#
# -- Push (Expo push service; the CRM "push" channel) --
# EXPO_PUSH_ENABLED: exactly "true" plugs the push transport into the CRM
#   dispatcher. It sends to the Expo push tokens the consumer app registers at
#   POST /consumer/push/register (consumer_push_devices). A member with no
#   registered device falls through to the trigger's next channel at once; a
#   token Expo reports as DeviceNotRegistered is dropped. Off (default): the
#   channel does not exist and push-primary triggers fall back exactly as
#   before. The app only mints a token once it is built with an EAS projectId.
EXPO_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN: optional Expo access token (expo.dev -> Access tokens),
#   sent as a Bearer header when the Expo project enforces push security.
EXPO_ACCESS_TOKEN=
#
# -- Operator push (Saathi store managers and riders, Firebase Cloud Messaging) --
# The Saathi app registers the FCM token of the handset an operator is signed
# in on at POST /api/v1/push/register (operator_push_devices) and drops it at
# sign-out. The backend then rings those phones for the store alerts that
# matter: a new instant order waiting for a rider (store managers + the
# store's riders), instant delivery closing / closed (store managers) and low
# stock (platform admins). Quiet hours 22:00-07:00 IST hold everything except
# order and delivery alerts (new order, closing); the inbox row stays either way.
# FCM_SERVICE_ACCOUNT_JSON: the service-account key file from the Firebase
#   console (Project settings -> Service accounts -> Generate new private key),
#   pasted raw or base64-encoded (base64 survives dashboards that mangle
#   newlines). Unset: the sender is inert and the boot log says so.
FCM_SERVICE_ACCOUNT_JSON=
# FCM_PROJECT_ID: optional; defaults to the service account's project_id.
FCM_PROJECT_ID=

# -- dry-run / local stubs (never set in production) --
# Each key replaces ONE provider's scheme://host for the outbound transport
# named below; the request path, method, headers and body stay exactly what
# production sends, so one local stub server (any HTTP listener that logs
# requests) captures what would have gone out. Unset = the real provider,
# byte-identical behaviour. The stub answers what the provider would: MSG91 a
# 200 with "type":"success" in the body, Meta a 200 JSON body, Expo a 200
# with one data[] ticket per message.
# CRM_MSG91_BASE_URL: MSG91 origin (default https://control.msg91.com) for
#   BOTH the CRM flow channel (POST /api/v5/flow/) and the login / delivery
#   OTP client (POST /api/v5/otp?template_id=..&mobile=..&otp=..).
# CRM_WA_BASE_URL: Meta Graph origin (default https://graph.facebook.com); the
#   CRM WhatsApp channel posts /v19.0/<CRM_WA_PHONE_ID>/messages.
# EXPO_PUSH_BASE_URL: Expo push origin (default https://exp.host); the push
#   channel posts /--/api/v2/push/send.
# FCM_BASE_URL: FCM origin (default https://fcm.googleapis.com); operator push
#   posts /v1/projects/<project>/messages:send. The OAuth2 token exchange goes
#   to the service account's own token_uri, so a dry-run service account points
#   token_uri at the same stub (answer {"access_token":"x","expires_in":3600}).
# CRM_MSG91_BASE_URL=http://127.0.0.1:9009
# CRM_WA_BASE_URL=http://127.0.0.1:9009
# EXPO_PUSH_BASE_URL=http://127.0.0.1:9009
# FCM_BASE_URL=http://127.0.0.1:9009

# -- Referrals + Founding Family (referrals.go, founding.go) --
# Money is in PAISE. The ERP's FOUNDING-99 / DELIVERY-FEE service prices win
# over the two *_PAISE fallbacks once the Dolibarr sync has seen them.
# REFERRAL_REWARD_PAISE: REWARDS credit to BOTH sides on the referee's first
#   paid delivery (default 10000 = Rs 100, the Refer screen's promise; 0 stops
#   paying).
REFERRAL_REWARD_PAISE=10000
# FOUNDING_PRICE_MONTH_PAISE: the monthly membership, also the join seat
#   (default 9900 = Rs 99).
FOUNDING_PRICE_MONTH_PAISE=9900
# FOUNDING_DELIVERY_FEE_PAISE: DELIVERY-FEE, the One Voice delivery charge on a
#   one-off order whose goods come to less than Rs 199 (free from Rs 199, never
#   for a Founding Family member, never on a subscription morning). The ERP's
#   DELIVERY-FEE service price wins once synced (default 500 = Rs 5; the app
#   shows Rs 5, so change both together).
FOUNDING_DELIVERY_FEE_PAISE=500
# FOUNDING_LEVEL3_OFF_PAISE_PER_LITRE: member price = level 1 minus this per
#   litre on PYAAS milk when the ERP carries no level 3 (default 200 = Rs 2/L;
#   0 = no derived discount).
FOUNDING_LEVEL3_OFF_PAISE_PER_LITRE=200
# FOUNDING_SAVINGS_SKU: the 1 L PYAAS line behind "1 L a day saves Rs X"
#   (falls back to the cheapest 1 L PYAAS milk on the catalog).
FOUNDING_SAVINGS_SKU=pyaas-toned-1l
# FOUNDING_BILL_RETRY_DAYS: short-wallet billing DAYS before a membership stops.
FOUNDING_BILL_RETRY_DAYS=3
# FOUNDING_FAMILY_CLOSED: true answers GET /founding-family with 404 (the app
#   says "opening soon").
FOUNDING_FAMILY_CLOSED=false
# FOUNDING_PYAAS_MEMBERS_ONLY: true refuses PYAAS milk to non-active members
#   (spec 5.1). The founder turns it on at launch ("PYAAS own-brand milk is
#   members-only at launch"), with the app build that shows the shop lock states.
FOUNDING_PYAAS_MEMBERS_ONLY=false
# FOUNDING_PYAAS_NONMEMBER_FEE: spec 5.3's non-member fee on PYAAS milk,
#   superseded by the One Voice rule (founder, 25 Sep: keep it off). On or off,
#   an order pays the One Voice fee once, and nothing from Rs 199.
FOUNDING_PYAAS_NONMEMBER_FEE=false
